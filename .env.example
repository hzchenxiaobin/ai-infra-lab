# AIInfra Lab 环境变量示例。拷贝为 .env 后填写；完整说明见 docs/06-development.md 第 8 节
# 与各 docs/dev/ 模块文档。标注【新增·未实现】的变量当前代码尚未读取，仅为目标形态占位。

# ===== 已有（apps/server/src/env.ts 生效）=====
# MySQL 连接串（compose 内主机名为 mysql:3306）
DATABASE_URL=mysql://root:root@localhost:3306/interview
# server 端口（web 的 vite proxy 指向此端口）
PORT=3001
# OpenAI 兼容端点（Moonshot / Kimi Code / CANNBot / vLLM）
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=moonshot-v1-8k
# 部分网关（如 cannbot）除 Bearer 外还要求 x-api-vkey 头
LLM_VKEY=

# ===== 认证（docs/dev/server.md）=====
# session cookie 签名密钥（apps/server 已读取；为空时开发模式用进程内随机密钥）
SESSION_SECRET=
# 管理员邮箱白名单（逗号分隔）：adminProcedure 与 CLI 管理命令（content:sync /
# user:* / quota:*，经 --user/-- AILAB_USER 指定）的身份来源
ADMIN_EMAILS=
# 注册验证码邮件发送（apps/server 已读取；SMTP_HOST 为空时 dev 模式把验证码打印到日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ===== LLM 模型分级（docs/dev/server.md）=====
# 追问/开场用便宜模型（发言类调用）；空 = 回落 LLM_MODEL
LLM_MODEL_FOLLOWUP=
# 评估用强模型（结构化评估调用）；空 = 回落 LLM_MODEL
LLM_MODEL_EVAL=
# LLM 日 token 预算（server /metrics/llm 打点 + monitor.sh 告警阈值；
# 0/空 = 不设预算只观测）
LLM_DAILY_TOKEN_BUDGET=

# ===== 评测队列（docs/dev/judge-worker.md）=====
# 同时在跑的评测并发上限（server in-process worker 与独立 judge-worker 通用）
JUDGE_CONCURRENCY=2
# 单用例评测超时（毫秒），judge-worker Docker runner 透传容器内
JUDGE_TIMEOUT_MS=8000
# 评测容器内存限额（MB），judge-worker Docker runner 用
JUDGE_MEM_MB=256
# false 时禁用 server 内置 in-process worker（部署形态：独立 judge-worker 接管执行）
JUDGE_INPROCESS_WORKER=

# ===== 配额默认值（docs/dev/server.md，M2 落地）=====
# NULL/空 = 不限（上线初期默认）；QUOTA_DEFAULT_LLM_TOKENS 尚未实现
QUOTA_DEFAULT_INTERVIEW=
QUOTA_DEFAULT_JUDGE=
QUOTA_DEFAULT_LLM_TOKENS=

# ===== 部署（deploy/docker-compose.yml 读取；开发机无需关心）=====
# 首次部署：先在 .env 配 ADMIN_EMAILS=ops@example.com → web 注册该邮箱 →
# CLI --user ops@example.com 跑 content:sync / user:claim 等管理命令
# MySQL 容器凭据。注意：改了 MYSQL_PASSWORD 后，compose 内 server/judge-worker
# 的连接串由这些变量组装（无需另改 DATABASE_URL）；宿主侧 DATABASE_URL（回环
# 3306）与备份脚本凭据需同步使用相同密码
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ailab
MYSQL_USER=ailab
MYSQL_PASSWORD=ailab
# 评测沙箱镜像（deploy/images/algo 预构建产物）
JUDGE_IMAGE=ailab/judge-algo:latest
# 监控告警 webhook（deploy/scripts/monitor.sh，飞书/钉钉通用 JSON；空 = 只打日志）
WEBHOOK_URL=
