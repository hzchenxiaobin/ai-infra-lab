# AIInfra Lab 环境变量示例。拷贝为 .env 后填写；完整说明见 docs/06-development.md 第 8 节
# 与各 docs/dev/ 模块文档。标注【新增·未实现】的变量当前代码尚未读取，仅为目标形态占位。

# ===== 已有（apps/server/src/env.ts 生效）=====
# MySQL 连接串（compose 内主机名为 mysql:3306）
DATABASE_URL=mysql://root:root@localhost:3306/interview
# server 端口（web 的 vite proxy 指向此端口）
PORT=3001
# OpenAI 兼容端点（Moonshot / Kimi Code / CANNBot / vLLM）
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=moonshot-v1-8k
# 部分网关（如 cannbot）除 Bearer 外还要求 x-api-vkey 头
LLM_VKEY=
# 【将退役】现状 judge 从本地 leetcode 仓库读参考代码/签名；
# 新产品改为 problems.testcases 入库后随 sync 模块一并移除
LEETCODE_REPO_DIR=

# ===== 认证（docs/dev/server.md）=====
# session cookie 签名密钥（apps/server 已读取；为空时开发模式用进程内随机密钥）
SESSION_SECRET=
# 注册验证码邮件发送（apps/server 已读取；SMTP_HOST 为空时 dev 模式把验证码打印到日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ===== LLM 模型分级（docs/dev/server.md）=====
# 【新增·未实现】追问/开场用便宜模型；缺省回落 LLM_MODEL
LLM_MODEL_FOLLOWUP=
# 【新增·未实现】评估用强模型；缺省回落 LLM_MODEL
LLM_MODEL_EVAL=

# ===== 评测沙箱 judge-worker（docs/dev/judge-worker.md，P7 实现）=====
# 【新增·未实现】同时在跑的评测容器数
JUDGE_CONCURRENCY=2
# 【新增·未实现】单题评测超时（毫秒）
JUDGE_TIMEOUT_MS=8000
# 【新增·未实现】评测容器内存限额（MB）
JUDGE_MEM_MB=256

# ===== 配额默认值（docs/dev/server.md，M2 落地）=====
# NULL/空 = 不限（上线初期默认）；QUOTA_DEFAULT_LLM_TOKENS 尚未实现
QUOTA_DEFAULT_INTERVIEW=
QUOTA_DEFAULT_JUDGE=
QUOTA_DEFAULT_LLM_TOKENS=
