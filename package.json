{
  "name": "ai-infra-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ailab/judge-core build && pnpm -r --parallel dev",
    "build": "pnpm -r --filter '!@ailab/docs' build",
    "build:docs": "pnpm --filter @ailab/docs build",
    "test": "pnpm --filter @ailab/judge-core build && pnpm -r test",
    "db:generate": "pnpm --filter @ailab/server db:generate",
    "db:migrate": "pnpm --filter @ailab/server db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@ailab/cli": "link:apps/cli"
  }
}
